{
  "name": "reel-studio",
  "private": true,
  "version": "1.0.0",
  "description": "Code-animated vertical reels built by the reel-factory agent team",
  "scripts": {
    "studio": "remotion studio",
    "sfx": "python3 scripts/sfx.py",
    "vo": "python3 scripts/vo.py",
    "render": "sh scripts/render.sh",
    "qa": "sh scripts/qa-frames.sh",
    "audio-check": "node scripts/audio-check.mjs",
    "typecheck": "tsc --noEmit",
    "frames": "sh scripts/frames.sh",
    "fonts": "python3 scripts/fonts.py",
    "edit": "python3 scripts/edit.py",
    "ig": "python3 scripts/ig.py",
    "trends": "python3 scripts/trends.py",
    "weekly": "python3 scripts/ig.py sync && python3 scripts/ig.py discover && python3 scripts/trends.py outliers && python3 scripts/trends.py report",
    "test": "python3 -m unittest discover -s tests",
    "fx:setup": "bash fx/scripts/setup.sh"
  },
  "dependencies": {
    "@react-three/fiber": "9.3.0",
    "@remotion/cli": "4.0.534",
    "@remotion/fonts": "4.0.534",
    "@remotion/google-fonts": "4.0.534",
    "@remotion/install-whisper-cpp": "4.0.534",
    "@remotion/paths": "4.0.534",
    "@remotion/three": "4.0.534",
    "@remotion/transitions": "4.0.534",
    "@types/three": "0.178.1",
    "lucide": "1.61.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.534",
    "three": "0.178.0"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "typescript": "5.8.3"
  }
}
